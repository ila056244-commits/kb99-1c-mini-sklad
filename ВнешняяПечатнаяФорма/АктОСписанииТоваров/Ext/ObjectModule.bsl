#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.9.144");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.0.0.1";

	ПараметрыРегистрации.Назначение.Добавить("Документ.СписаниеНедостачТоваров");

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = НСтр("ru = 'Акт о списании (внешняя)'");
	НоваяКоманда.Идентификатор = "АктОСписанииТоваров";
	НоваяКоманда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.Модификатор = "ПечатьMXL";

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

    ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "АктОСписанииТоваров");
    Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = СформироватьАктОСписании(МассивОбъектов, ОбъектыПечати);
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Акт о списании товаров'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьАктОСписании(МассивОбъектов, ОбъектыПечати)

	УстановитьПривилегированныйРежим(Истина);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктОСписании";

	Макет = ПолучитьМакет("ПФ_MXL_АктОСписании");
	Запрос = Новый Запрос(ТекстЗапросаДляПечати());
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Результат = Запрос.ВыполнитьПакет();

	Шапка = Результат[0].Выбрать();
	ТаблицаТоваров = Результат[1].Выгрузить();

	ПервыйДокумент = Истина;

	Пока Шапка.Следующий() Цикл

		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;

		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтрокиДокумента = ТаблицаТоваров.НайтиСтроки(Новый Структура("Ссылка", Шапка.Ссылка));

		// Шапка акта
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ОбластьШапка.Параметры.Заголовок = СтрШаблон(
			НСтр("ru = 'Акт о списании товаров № %1 от %2'"),
			Шапка.Номер,
			Формат(Шапка.Дата, "ДЛФ=DD"));
		ОбластьШапка.Параметры.Организация   = Шапка.ОрганизацияПолноеНаименование;
		ОбластьШапка.Параметры.Подразделение = Шапка.Подразделение;
		ОбластьШапка.Параметры.Склад         = Шапка.Склад;
		ШтрихкодированиеПечатныхФорм.ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, ОбластьШапка, Шапка.Ссылка);
		ТабличныйДокумент.Вывести(ОбластьШапка);

		// Таблица товаров
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы"));
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		Для Каждого СтрокаТовара Из СтрокиДокумента Цикл
			ОбластьСтрока.Параметры.НомерСтроки = СтрокаТовара.НомерСтроки;
			ОбластьСтрока.Параметры.Товар       = ПредставлениеТовара(СтрокаТовара);
			ОбластьСтрока.Параметры.Количество  = СтрокаТовара.Количество;
			ОбластьСтрока.Параметры.ЕдИзм       = СтрокаТовара.ЕдиницаИзмерения;
			ТабличныйДокумент.Вывести(ОбластьСтрока);
		КонецЦикла;

		// Подвал
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		ОбластьПодвал.Параметры.ВсегоНаименований = СтрокиДокумента.Количество();
		ОбластьПодвал.Параметры.Ответственный     = Строка(Шапка.Ответственный);
		ОбластьПодвал.Параметры.ЗавСкладом        = Строка(Шапка.Руководитель);
		ОбластьПодвал.Параметры.Причина           = Шапка.Комментарий;
		ТабличныйДокумент.Вывести(ОбластьПодвал);

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);

	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции

Функция ПредставлениеТовара(СтрокаТовара)

	Представление = СтрокаТовара.Товар;
	Если ЗначениеЗаполнено(СтрокаТовара.Характеристика) Тогда
		Представление = Представление + ", " + СтрокаТовара.Характеристика;
	КонецЕсли;
	Возврат Представление;

КонецФункции

Функция ТекстЗапросаДляПечати()

	Возврат
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Номер КАК Номер,
	|	Док.Дата КАК Дата,
	|	Док.Организация.НаименованиеПолное КАК ОрганизацияПолноеНаименование,
	|	Док.Подразделение КАК Подразделение,
	|	Док.Склад КАК Склад,
	|	Док.Ответственный КАК Ответственный,
	|	Док.Руководитель КАК Руководитель,
	|	Док.Комментарий КАК Комментарий
	|ИЗ
	|	Документ.СписаниеНедостачТоваров КАК Док
	|ГДЕ
	|	Док.Ссылка В(&МассивОбъектов)
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата,
	|	Док.Номер
	|;
	|ВЫБРАТЬ
	|	Товары.Ссылка КАК Ссылка,
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура.НаименованиеПолное КАК Товар,
	|	Товары.Характеристика.Наименование КАК Характеристика,
	|	Товары.Количество КАК Количество,
	|	Товары.Номенклатура.ЕдиницаИзмерения.Наименование КАК ЕдиницаИзмерения
	|ИЗ
	|	Документ.СписаниеНедостачТоваров.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка В(&МассивОбъектов)
	|УПОРЯДОЧИТЬ ПО
	|	Товары.НомерСтроки";

КонецФункции

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли