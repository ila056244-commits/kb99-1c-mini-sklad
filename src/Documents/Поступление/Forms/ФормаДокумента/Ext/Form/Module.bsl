#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформлениеТоваров();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы <> "Справочник.Товары.Форма.ФормаПодбора" Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьТоварыИзПодбора(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	РассчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("РежимВыбора", Истина);
	ПараметрыПодбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыПодбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.Товары.Форма.ФормаПодбора", ПараметрыПодбора, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьТоварыИзПодбора(ВыбранныеТовары)
	
	ПодобранныеТовары = Новый Массив;
	Если ТипЗнч(ВыбранныеТовары) = Тип("Массив") Тогда
		ПодобранныеТовары = ВыбранныеТовары;
	Иначе
		ПодобранныеТовары.Добавить(ВыбранныеТовары);
	КонецЕсли;
	
	ПоследняяСтрока = Неопределено;
	
	Для Каждого Товар Из ПодобранныеТовары Цикл
		
		НайденныеСтроки = Объект.Товары.НайтиСтроки(Новый Структура("Товар", Товар));
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТоваров = НайденныеСтроки[0];
			СтрокаТоваров.Количество = СтрокаТоваров.Количество + 1;
		Иначе
			СтрокаТоваров = Объект.Товары.Добавить();
			СтрокаТоваров.Товар = Товар;
			СтрокаТоваров.Количество = 1;
		КонецЕсли;
		
		РассчитатьСуммуСтроки(СтрокаТоваров);
		ПоследняяСтрока = СтрокаТоваров;
		
	КонецЦикла;
	
	Если ПоследняяСтрока <> Неопределено Тогда
		Модифицированность = Истина;
		Элементы.Товары.ТекущаяСтрока = ПоследняяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуСтроки(СтрокаТоваров)
	
	Если СтрокаТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеТоваров()
	
	УсловноеОформление.Элементы.Очистить();
	
	ДобавитьОформлениеНезаполненногоПоля("ТоварыКоличество", "Объект.Товары.Количество");
	ДобавитьОформлениеНезаполненногоПоля("ТоварыЦена", "Объект.Товары.Цена");
	ДобавитьОформлениеНезаполненногоПоля("ТоварыСумма", "Объект.Товары.Сумма");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеНезаполненногоПоля(ИмяЭлементаФормы, ПутьКДанным)
	
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	
	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаФормы);
	ОформляемоеПоле.Использование = Истина;
	
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = 0;
	ЭлементОтбора.Использование = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 230, 230));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	
КонецПроцедуры

#КонецОбласти
