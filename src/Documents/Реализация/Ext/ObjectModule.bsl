#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	#Область ПроверкаЗаполненияТабличнойЧасти
	Если Товары.Количество() = 0 Тогда
		Отказ = Истина;
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Табличная часть ""Товары"" не заполнена! Проведение невозможно.";
		СообщениеПользователю.Поле = "Товары";
		СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	#КонецОбласти

	#Область БлокировкаДанных
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	БлокировкаДанных.Заблокировать();
	#КонецОбласти
	
	#Область СозданиеНаборовЗаписей
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	#КонецОбласти

	#Область ЗапросОстатков
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	СУММА(РеализацияТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.Реализация.Товары КАК РеализацияТовары
	|ГДЕ
	|	РеализацияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТовары.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Товар КАК Товар,
	|	ЕСТЬNULL(ВТ_Товары.Количество, 0) КАК КоличествоВДокументе,
	|	ЕСТЬNULL(ОстаткиТоваровОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	СправочникТовары.Наименование КАК ТоварПредставление
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Товары КАК СправочникТовары
	|			ПО ВТ_Товары.Товар = СправочникТовары.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Товар В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Товар
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары)) КАК ОстаткиТоваровОстатки
	|		ПО ВТ_Товары.Товар = ОстаткиТоваровОстатки.Товар";

	ЗапросОстатков.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатков.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	ВыборкаОстатков = РезультатЗапросаОстатков.Выбрать();

	Пока ВыборкаОстатков.Следующий() Цикл
		Превышение = ВыборкаОстатков.КоличествоВДокументе - ВыборкаОстатков.КоличествоОстаток;
		Если Превышение > 0 Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = СтрШаблон(
				"Не хватает товара ""%1"". Требуется: %2, остаток на складе: %3",
				ВыборкаОстатков.ТоварПредставление,
				ВыборкаОстатков.КоличествоВДокументе,
				ВыборкаОстатков.КоличествоОстаток
			);
			СообщениеПользователю.Поле = "Товары";
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	#КонецОбласти

	#Область ЗаписьДвижений
	Для Каждого СтрокаТоваров Из Товары Цикл
		ДвижениеОстатковТоваров = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатковТоваров.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатковТоваров.Период = Дата;
		ДвижениеОстатковТоваров.Товар = СтрокаТоваров.Товар;
		ДвижениеОстатковТоваров.Количество = СтрокаТоваров.Количество;
	КонецЦикла;
	#КонецОбласти

КонецПроцедуры

#КонецОбласти