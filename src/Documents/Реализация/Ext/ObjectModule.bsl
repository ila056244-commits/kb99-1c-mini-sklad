#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.Продажи.Записывать = Истина;
	Движения.Продажи.Очистить();
	
	
	// Исключительная блокировка по товарам: контроль FIFO и параллельное проведение.
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	БлокировкаДанных.Заблокировать();
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =                                                          
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	СУММА(РеализацияТовары.Количество) КАК Количество,
	|	СУММА(РеализацияТовары.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	Документ.Реализация.Товары КАК РеализацияТовары
	|ГДЕ
	|	РеализацияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТовары.Товар
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Товары.Товар КАК Товар,
	|	ЕСТЬNULL(ВТ_Товары.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ВТ_Товары.Сумма, 0) КАК Сумма,
	|	ТоварыОстатки.Партия КАК Партия,
	|	ЕСТЬNULL(ТоварыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ТоварыОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	|ИЗ
	|	ВТ_Товары КАК ВТ_Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Товар В
	|					(ВЫБРАТЬ
	|						ВТ_Товары.Товар
	|					ИЗ
	|						ВТ_Товары КАК ВТ_Товары)) КАК ТоварыОстатки
	|		ПО ВТ_Товары.Товар = ТоварыОстатки.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыОстатки.Партия.Дата
	|ИТОГИ
	|	МАКСИМУМ(Количество),
	|	МАКСИМУМ(Сумма),
	|	СУММА(КоличествоОстаток)
	|ПО
	|	Товар";
	
	ЗапросОстатков.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатков.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	ВыборкаТовары = РезультатЗапросаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаТовары.Следующий() Цикл
		
		Если ВыборкаТовары.КоличествоОстаток < ВыборкаТовары.Количество Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = СтрШаблон(
				"Не хватает товара ""%1"". Требуется: %2, остаток на складе: %3",
				ВыборкаТовары.Товар,
				ВыборкаТовары.Количество,
				ВыборкаТовары.КоличествоОстаток
			);
			НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Товар", ВыборкаТовары.Товар));
			Если НайденныеСтроки.Количество() > 0 Тогда
				ИндексСтроки = НайденныеСтроки[0].НомерСтроки - 1;
				СообщениеПользователю.Поле = "Товары[" + Формат(ИндексСтроки, "ЧГ=0") + "].Количество";
			КонецЕсли;
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		// Продолжаем обход после отказа, чтобы показать нехватку по всем товарам сразу.
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ОсталосьСписать = ВыборкаТовары.Количество;
		СебестоимостьТовара = 0;
		
		ВыборкаПартии = ВыборкаТовары.Выбрать();
		Пока ВыборкаПартии.Следующий() И ОсталосьСписать > 0 Цикл
			
			Если ВыборкаПартии.КоличествоОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СписываемКоличество = Мин(ВыборкаПартии.КоличествоОстаток, ОсталосьСписать);
			Если СписываемКоличество = ВыборкаПартии.КоличествоОстаток Тогда
				СписываемСебестоимость = ВыборкаПартии.СуммаОстаток;
			Иначе
				СписываемСебестоимость = Окр(
					СписываемКоличество / ВыборкаПартии.КоличествоОстаток * ВыборкаПартии.СуммаОстаток,
					2
				);
			КонецЕсли;
			
			ДвижениеОстатковТоваров = Движения.ОстаткиТоваров.Добавить();
			ДвижениеОстатковТоваров.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОстатковТоваров.Период = Дата;
			ДвижениеОстатковТоваров.Товар = ВыборкаТовары.Товар;
			ДвижениеОстатковТоваров.Партия = ВыборкаПартии.Партия;
			ДвижениеОстатковТоваров.Количество = СписываемКоличество;
			ДвижениеОстатковТоваров.Сумма = СписываемСебестоимость;
			
			ОсталосьСписать = ОсталосьСписать - СписываемКоличество;
			СебестоимостьТовара = СебестоимостьТовара + СписываемСебестоимость;
			
		КонецЦикла;
		
		Если ОсталосьСписать > 0 Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = СтрШаблон(
				"Не удалось списать товар ""%1"" по партиям. Не покрыто количество: %2",
				ВыборкаТовары.Товар,
				ОсталосьСписать
			);
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Товар = ВыборкаТовары.Товар;
		ДвижениеПродажи.Контрагент = Контрагент;
		ДвижениеПродажи.Количество = ВыборкаТовары.Количество;
		ДвижениеПродажи.Сумма = ВыборкаТовары.Сумма;
		ДвижениеПродажи.Себестоимость = СебестоимостьТовара;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
