#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОстаткиТоваров.Очистить();
	Движения.Продажи.Записывать = Истина;
	Движения.Продажи.Очистить();
	
	
	// Исключительная блокировка по товарам: контроль FIFO и параллельное проведение.
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	БлокировкаДанных.Заблокировать();
	
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст =                                                          
	"ВЫБРАТЬ
	|	РеализацияТовары.Товар КАК Товар,
	|	СУММА(РеализацияТовары.Количество) КАК Количество,
	|	СУММА(РеализацияТовары.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_ТоварыРеализации
	|ИЗ
	|	Документ.Реализация.Товары КАК РеализацияТовары
	|ГДЕ
	|	РеализацияТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТовары.Товар
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыРеализации.Товар КАК Товар,
	|	ЕСТЬNULL(ТоварыРеализации.Количество, 0) КАК Количество,
	|	ЕСТЬNULL(ТоварыРеализации.Сумма, 0) КАК Сумма,
	|	ТоварыОстатки.Партия КАК Партия,
	|	ЕСТЬNULL(ТоварыОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(ТоварыОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	|ИЗ
	|	ВТ_ТоварыРеализации КАК ТоварыРеализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				Товар В
	|					(ВЫБРАТЬ
	|						ТоварыОтбора.Товар
	|					ИЗ
	|						ВТ_ТоварыРеализации КАК ТоварыОтбора)) КАК ТоварыОстатки
	|		ПО ТоварыРеализации.Товар = ТоварыОстатки.Товар
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыОстатки.Партия.Дата,
	|	ТоварыОстатки.Партия
	|ИТОГИ
	|	МАКСИМУМ(Количество),
	|	МАКСИМУМ(Сумма),
	|	СУММА(КоличествоОстаток)
	|ПО
	|	Товар";
	
	ЗапросОстатков.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатков.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	ТоварыДокумента = РезультатЗапросаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ТоварыДокумента.Следующий() Цикл
		
		Если ТоварыДокумента.КоличествоОстаток < ТоварыДокумента.Количество Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = СтрШаблон(
				"Не хватает товара ""%1"". Требуется: %2, остаток на складе: %3",
				ТоварыДокумента.Товар,
				ТоварыДокумента.Количество,
				ТоварыДокумента.КоличествоОстаток
			);
			НайденныеСтроки = Товары.НайтиСтроки(Новый Структура("Товар", ТоварыДокумента.Товар));
			Если НайденныеСтроки.Количество() > 0 Тогда
				ИндексСтроки = НайденныеСтроки[0].НомерСтроки - 1;
				СообщениеПользователю.Поле = "Товары[" + Формат(ИндексСтроки, "ЧГ=0") + "].Количество";
			КонецЕсли;
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		// Продолжаем обход после отказа, чтобы показать нехватку по всем товарам сразу.
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		ОсталосьСписать = ТоварыДокумента.Количество;
		СебестоимостьТовара = 0;
		
		ПартииТовары = ТоварыДокумента.Выбрать();
		Пока ПартииТовары.Следующий() И ОсталосьСписать > 0 Цикл
			
			Если ПартииТовары.КоличествоОстаток <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СписываемКоличество = Мин(ПартииТовары.КоличествоОстаток, ОсталосьСписать);
			Если СписываемКоличество = ПартииТовары.КоличествоОстаток Тогда
				СписываемСебестоимость = ПартииТовары.СуммаОстаток;
			Иначе
				СписываемСебестоимость = Окр(
					СписываемКоличество / ПартииТовары.КоличествоОстаток * ПартииТовары.СуммаОстаток,
					2
				);
			КонецЕсли;
			
			ДвижениеОстатков = Движения.ОстаткиТоваров.Добавить();
			ДвижениеОстатков.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОстатков.Период = Дата;
			ДвижениеОстатков.Товар = ТоварыДокумента.Товар;
			ДвижениеОстатков.Партия = ПартииТовары.Партия;
			ДвижениеОстатков.Количество = СписываемКоличество;
			ДвижениеОстатков.Сумма = СписываемСебестоимость;
			
			ОсталосьСписать = ОсталосьСписать - СписываемКоличество;
			СебестоимостьТовара = СебестоимостьТовара + СписываемСебестоимость;
			
		КонецЦикла;
		
		Если ОсталосьСписать > 0 Тогда
			СообщениеПользователю = Новый СообщениеПользователю;
			СообщениеПользователю.Текст = СтрШаблон(
				"Не удалось списать товар ""%1"" по партиям. Не покрыто количество: %2",
				ТоварыДокумента.Товар,
				ОсталосьСписать
			);
			СообщениеПользователю.УстановитьДанные(ЭтотОбъект);
			СообщениеПользователю.Сообщить();
			Отказ = Истина;
			Продолжить;
		КонецЕсли;
		
		ДвижениеПродаж = Движения.Продажи.Добавить();
		ДвижениеПродаж.Период = Дата;
		ДвижениеПродаж.Товар = ТоварыДокумента.Товар;
		ДвижениеПродаж.Контрагент = Контрагент;
		ДвижениеПродаж.Количество = ТоварыДокумента.Количество;
		ДвижениеПродаж.Сумма = ТоварыДокумента.Сумма;
		ДвижениеПродаж.Себестоимость = СебестоимостьТовара;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
