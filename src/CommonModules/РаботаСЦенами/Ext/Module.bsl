#Область ПрограммныйИнтерфейс

// Возвращает последнюю установленную цену номенклатуры на дату.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Товары
//  ДатаЦены     - Дата - если не заполнена, берется текущая дата сеанса.
//
// Возвращаемое значение:
//  Число - цена или 0, если цена не установлена.
//
Функция ПолучитьЦенуНоменклатурыНаДату(Номенклатура, ДатаЦены) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаЦены) Тогда
		ДатаЦены = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Сумма КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних
	|УПОРЯДОЧИТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Период", ДатаЦены);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

// Возвращает последние установленные цены списка номенклатуры на дату одним запросом.
//
// Параметры:
//  МассивТоваров - Массив из СправочникСсылка.Товары
//  ДатаЦены      - Дата - если не заполнена, берется текущая дата сеанса.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Товары, значение: Число - цена или 0, если цена не установлена.
//
Функция ПолучитьЦеныНоменклатурыНаДату(Знач МассивТоваров, Знач ДатаЦены) Экспорт

	Цены = Новый Соответствие;

	Для Каждого Товар Из МассивТоваров Цикл
		Цены.Вставить(Товар, 0);
	КонецЦикла;

	Если Цены.Количество() = 0 Тогда
		Возврат Цены;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаЦены) Тогда
		ДатаЦены = ТекущаяДатаСеанса();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Сумма КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, Номенклатура В (&Товары)) КАК ЦеныНоменклатурыСрезПоследних
	|УПОРЯДОЧИТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.Период";

	Запрос.УстановитьПараметр("Период", ДатаЦены);
	Запрос.УстановитьПараметр("Товары", МассивТоваров);

	Выборка = Запрос.Выполнить().Выбрать();

	// При упорядочивании по возрастанию периода последней записывается самая поздняя цена.
	Пока Выборка.Следующий() Цикл
		Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;

	Возврат Цены;

КонецФункции

#КонецОбласти
