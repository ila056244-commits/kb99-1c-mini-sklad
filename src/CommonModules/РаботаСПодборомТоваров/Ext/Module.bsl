#Область ПрограммныйИнтерфейс

// Добавляет подобранные товары в табличную часть документа на форме.
// Для уже имеющегося товара увеличивает количество на 1, для нового добавляет строку
// с количеством 1 и ценой на дату. Цены новых товаров получаются одним серверным вызовом.
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - форма документа с реквизитом Объект.
//  ВыбранныеТовары   - СправочникСсылка.Товары, Массив из СправочникСсылка.Товары - результат подбора.
//  ИмяТабличнойЧасти - Строка - имя табличной части объекта и одноименного элемента формы.
//  ДатаЦены          - Дата - дата, на которую берутся цены.
//
Процедура ДобавитьТоварыИзПодбора(Форма, ВыбранныеТовары, ИмяТабличнойЧасти, Знач ДатаЦены) Экспорт

	ПодобранныеТовары = Новый Массив;
	Если ТипЗнч(ВыбранныеТовары) = Тип("Массив") Тогда
		ПодобранныеТовары = ВыбранныеТовары;
	Иначе
		ПодобранныеТовары.Добавить(ВыбранныеТовары);
	КонецЕсли;

	ТабличнаяЧасть = Форма.Объект[ИмяТабличнойЧасти];

	ТоварыДляЦен = Новый Массив;
	Для Каждого Товар Из ПодобранныеТовары Цикл
		Если ТоварыДляЦен.Найти(Товар) = Неопределено Тогда
			ТоварыДляЦен.Добавить(Товар);
		КонецЕсли;
	КонецЦикла;

	Если ТоварыДляЦен.Количество() > 0 Тогда
		ЦеныТоваров = РаботаСЦенами.ПолучитьЦеныНоменклатурыНаДату(ТоварыДляЦен, ДатаЦены);
	Иначе
		ЦеныТоваров = Новый Соответствие;
	КонецЕсли;

	ПоследняяСтрока = Неопределено;

	Для Каждого Товар Из ПодобранныеТовары Цикл

		НайденныеСтроки = ТабличнаяЧасть.НайтиСтроки(Новый Структура("Товар", Товар));
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаТоваров = НайденныеСтроки[0];
			СтрокаТоваров.Количество = СтрокаТоваров.Количество + 1;
		Иначе
			СтрокаТоваров = ТабличнаяЧасть.Добавить();
			СтрокаТоваров.Товар = Товар;
			СтрокаТоваров.Количество = 1;
			Цена = ЦеныТоваров.Получить(Товар);
			СтрокаТоваров.Цена = ?(Цена = Неопределено, 0, Цена);
		КонецЕсли;

		РаботаСЦенамиТЧ.РассчитатьСуммуСтроки(СтрокаТоваров);
		ПоследняяСтрока = СтрокаТоваров;

	КонецЦикла;

	Если ПоследняяСтрока <> Неопределено Тогда
		Форма.Модифицированность = Истина;
		Форма.Элементы[ИмяТабличнойЧасти].ТекущаяСтрока = ПоследняяСтрока.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

// Устанавливает условное оформление незаполненных (нулевых) полей
// Количество, Цена и Сумма табличной части товаров.
// Существующие элементы условного оформления формы очищаются.
//
// Параметры:
//  УсловноеОформление - НастройкиОформленияКомпоновкиДанных - условное оформление формы.
//  ИмяТабличнойЧасти  - Строка - имя табличной части объекта и одноименного элемента формы.
//
Процедура УстановитьУсловноеОформлениеТоваров(УсловноеОформление, ИмяТабличнойЧасти) Экспорт

	УсловноеОформление.Элементы.Очистить();

	ПутьКТабличнойЧасти = "Объект." + ИмяТабличнойЧасти + ".";

	ДобавитьОформлениеНезаполненногоПоля(УсловноеОформление,
		ИмяТабличнойЧасти + "Количество", ПутьКТабличнойЧасти + "Количество");
	ДобавитьОформлениеНезаполненногоПоля(УсловноеОформление,
		ИмяТабличнойЧасти + "Цена", ПутьКТабличнойЧасти + "Цена");
	ДобавитьОформлениеНезаполненногоПоля(УсловноеОформление,
		ИмяТабличнойЧасти + "Сумма", ПутьКТабличнойЧасти + "Сумма");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОформлениеНезаполненногоПоля(УсловноеОформление, ИмяЭлементаФормы, ПутьКДанным)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();

	ОформляемоеПоле = ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаФормы);
	ОформляемоеПоле.Использование = Истина;

	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКДанным);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = 0;
	ЭлементОтбора.Использование = Истина;

	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 230, 230));
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);

КонецПроцедуры

#КонецОбласти
