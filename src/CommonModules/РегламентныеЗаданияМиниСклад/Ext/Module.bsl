#Область ПрограммныйИнтерфейс

// Обработчик регламентного задания ПроведениеНепроведённыхДокументов.
// Проводит все непроведённые и не помеченные на удаление документы
// Поступление и Реализация в хронологическом порядке.
// Ошибка проведения отдельного документа не прерывает обработку остальных:
// она записывается в журнал регистрации, а в конце записывается итог.
//
Процедура ПровестиНепроведённыеДокументы() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Поступление.Ссылка КАК Ссылка,
	|	Поступление.Дата КАК Дата
	|ИЗ
	|	Документ.Поступление КАК Поступление
	|ГДЕ
	|	Поступление.Проведен = ЛОЖЬ
	|	И Поступление.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Реализация.Ссылка,
	|	Реализация.Дата
	|ИЗ
	|	Документ.Реализация КАК Реализация
	|ГДЕ
	|	Реализация.Проведен = ЛОЖЬ
	|	И Реализация.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Выборка = Запрос.Выполнить().Выбрать();

	КоличествоПроведено = 0;
	КоличествоОшибок = 0;

	Пока Выборка.Следующий() Цикл

		// Сбрасываем сообщения, накопленные при обработке предыдущих документов.
		ПолучитьСообщенияПользователю(Истина);

		Попытка
			Объект = Выборка.Ссылка.ПолучитьОбъект();

			// При записи из кода платформа не вызывает проверку заполнения, вызываем её явно.
			Если Не Объект.ПроверитьЗаполнение() Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
				ТекстОшибки = ПодробноеОписаниеОшибкиПроведения(Выборка.Ссылка,
					НСтр("ru = 'Не пройдена проверка заполнения.'"));
				ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(),
					УровеньЖурналаРегистрации.Ошибка,
					Выборка.Ссылка.Метаданные(),
					Выборка.Ссылка,
					ТекстОшибки);
				Продолжить;
			КонецЕсли;

			Объект.Записать(РежимЗаписиДокумента.Проведение);
			КоличествоПроведено = КоличествоПроведено + 1;
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
			ТекстОшибки = ПодробноеОписаниеОшибкиПроведения(Выборка.Ссылка, ОписаниеОшибки());
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(),
				УровеньЖурналаРегистрации.Ошибка,
				Выборка.Ссылка.Метаданные(),
				Выборка.Ссылка,
				ТекстОшибки);
		КонецПопытки;

	КонецЦикла;

	ТекстИтога = СтрШаблон(НСтр("ru = 'Проведено: %1, с ошибками: %2'"),
		Формат(КоличествоПроведено, "ЧН=0; ЧГ=0"),
		Формат(КоличествоОшибок, "ЧН=0; ЧГ=0"));

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		ТекстИтога);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает имя события журнала регистрации для проведения документов.
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция ИмяСобытияЖурнала()

	Возврат НСтр("ru = 'МиниСклад.ПроведениеДокументов'");

КонецФункции

// Формирует текст ошибки проведения документа для журнала регистрации.
// К описанию исключения добавляются тексты сообщений пользователю,
// накопленные при записи документа (например, из ОбработкаПроверкиЗаполнения).
// Накопленные сообщения при этом удаляются.
//
// Параметры:
//  Документ       - ДокументСсылка.Поступление, ДокументСсылка.Реализация - документ, который не удалось провести.
//  ОписаниеОшибки - Строка - описание исключения, полученное в блоке Исключение.
//
// Возвращаемое значение:
//  Строка - подробный текст ошибки.
//
Функция ПодробноеОписаниеОшибкиПроведения(Документ, ОписаниеОшибки)

	ТекстОшибки = СтрШаблон(
		НСтр("ru = 'Не удалось провести документ %1 по причине:
		|%2'"),
		Строка(Документ),
		ОписаниеОшибки);

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Для Каждого СообщениеПользователю Из Сообщения Цикл
		ТекстОшибки = ТекстОшибки + Символы.ПС + СообщениеПользователю.Текст;
	КонецЦикла;

	Возврат ТекстОшибки;

КонецФункции

#КонецОбласти
